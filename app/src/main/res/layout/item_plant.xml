<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPlantItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#33FFFFFF" app:cardCornerRadius="20dp"
    app:cardElevation="0dp"             app:strokeColor="#99FFFFFF"         app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="10dp">

            <View
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_plant_icon_circle"
                android:backgroundTint="#22FFFFFF"/>

            <TextView
                android:id="@+id/tvPlantIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🌱"
                android:textSize="30sp"/>

            <TextView
                android:id="@+id/tvCheckBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:text="✓"
                android:textSize="11sp"
                android:textColor="#2D3436" android:textStyle="bold"
                android:fontFamily="@font/montserrat_bold"
                android:background="@drawable/bg_check_badge_lime"
                android:visibility="gone"/>

        </FrameLayout>

        <TextView
            android:id="@+id/tvPlantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cà chua"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#2D3436" android:fontFamily="@font/montserrat_bold"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvPlantThreshold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18 ~ 30°C"
            android:textSize="11sp"
            android:textColor="#636E72" android:fontFamily="@font/montserrat_medium"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvRecommendedMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Phát triển"
            android:textSize="10sp"
            android:textColor="#A29BFE" android:fontFamily="@font/montserrat_medium"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_led_mode_tag"
            android:backgroundTint="#22A29BFE"/> </LinearLayout>

</com.google.android.material.card.MaterialCardView>